# ─── Admin (compte unique, mot de passe CHIFFRÉ bcrypt) ───
# Générez avec : npm run seed:admin -- MonMotDePasse
ADMIN_USERNAME=sensei.admin
# Sur Vercel (dashboard) → hash brut tel quel :
# ADMIN_PASSWORD_HASH=$2a$12$...............................................
# En local (.env) → version base64 (le `$` du hash brut est mangé par les parseurs .env) :
ADMIN_PASSWORD_HASH_B64=JDJhJDEyJC4uLgottenez-le-via-npm-run-seed-adminLi4=
# Clé de session (32+ caractères aléatoires) — OBLIGATOIRE en prod
SESSION_SECRET=changez-moi-avec-une-chaine-aleatoire-de-32-caracteres-min

# ─── Vercel Postgres (base de données prod) — optionnel en local (JSON fallback) ───
# POSTGRES_URL=postgres://...
# POSTGRES_PRISMA_URL=postgres://...
# POSTGRES_URL_NON_POOLING=postgres://...

# ─── Vercel Blob (stockage fichiers prod) — optionnel en local (public/uploads) ───
# BLOB_READ_WRITE_TOKEN=vercel_blob_...

# ─── Firebase (copie cloud des inscriptions) — optionnel ───
# Collez le JSON du compte de service Firebase Admin SDK (projet Firestore)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_STORAGE_BUCKET=mon-projet.appspot.com

# ─── WhatsApp du club ───
NEXT_PUBLIC_WHATSAPP_NUMBER=243000000000

# ─── Divers ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
